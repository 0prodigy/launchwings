{
  "name": "@launchwings/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./dist/schema.js"
    },
    "./client/http": {
      "types": "./src/client-http.ts",
      "import": "./dist/client-http.js"
    },
    "./client/pool": {
      "types": "./src/client-pool.ts",
      "import": "./dist/client-pool.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/migrate.ts",
    "db:reset": "tsx src/reset.ts",
    "migrate:roundtrip": "tsx scripts/migrate-roundtrip.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.0",
    "drizzle-orm": "0.36.4",
    "pg": "^8.13.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@launchwings/tsconfig": "workspace:*",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
