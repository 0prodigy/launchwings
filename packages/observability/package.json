{
  "name": "@launchwings/observability",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./otel": {
      "types": "./src/otel.ts",
      "import": "./dist/otel.js"
    },
    "./sentry": {
      "types": "./src/sentry.ts",
      "import": "./dist/sentry.js"
    },
    "./log": {
      "types": "./src/log.ts",
      "import": "./dist/log.js"
    },
    "./span": {
      "types": "./src/span.ts",
      "import": "./dist/span.js"
    },
    "./env": {
      "types": "./src/env.ts",
      "import": "./dist/env.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.75.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.217.0",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@sentry/nextjs": "^10.0.0",
    "@sentry/node": "^10.0.0"
  },
  "devDependencies": {
    "@launchwings/tsconfig": "workspace:*",
    "typescript": "^5.7.0"
  }
}
