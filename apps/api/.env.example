# Copy to .env and fill in. NEVER commit .env.
#
# NOTE: as of this snapshot, apps/api's src/index.ts does not itself load a
# .env file (no dotenv / --env-file wiring found) — export these in your
# shell, or wire up your own loader, until that's fixed. docs/DEV_SETUP.md
# only documents the apps/web env-var flow today, not apps/api's.
#
# Full schema (incl. which vars are required vs optional in production) lives
# in src/env.ts — this file mirrors it.

NODE_ENV=development
PORT=3001
# Surfaces in /health for deploy verification. Set in fly.toml/[env] or by CI.
GIT_SHA=dev
# CORS allowlist, comma-separated. Empty = same-origin only.
ALLOWED_ORIGINS=https://launchwings.com,https://www.launchwings.com,http://localhost:3000

# Clerk — auth (SETUP-03). Get from https://dashboard.clerk.com (API Keys).
# Dev tolerates absence: the api boots in degraded mode (X-Test-* headers
# only) and logs a warning instead of crashing.
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Optional — enables offline JWT verification (no network roundtrip to Clerk).
# CLERK_JWT_KEY=

# Production-only escape hatch documented in env.ts: set to "1" to let the api
# boot in production without CLERK_SECRET_KEY (auth-protected routes 401).
# Only for first-deploy bootstrap before Clerk is provisioned.
# LAUNCHWINGS_ALLOW_DEGRADED_AUTH=1

# Trigger.dev v3 (SETUP-04). Both optional; unset means the /trpc/agents.*
# procedures return PRECONDITION_FAILED instead of dispatching.
# TRIGGER_SECRET_KEY=
# TRIGGER_PROJECT_REF=

# Observability (SETUP-06). All optional — see docs/architecture/OBSERVABILITY.md.
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# AXIOM_TOKEN=
# AXIOM_DATASET=
# SERVICE_VERSION=

# LLM provider keys (SETUP-05). Production should have at least one; cassette
# replay covers the test path without either. The llm() wrapper throws a
# typed LLMConfigError on first real call when the requested provider's key
# is unset.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ONB-01: URL importer (Firecrawl crawl + Browserbase screenshot). All
# optional; products.import throws PRECONDITION_FAILED when any is unset.
# FIRECRAWL_API_KEY=
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
