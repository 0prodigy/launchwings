# Copy to .env.local and fill in. NEVER commit .env.local.

# Postgres (Neon recommended — see docs/DEV_SETUP.md "Local development").
# @launchwings/db accepts either var; DATABASE_URL_POOLED falls back to
# DATABASE_URL when unset.
DATABASE_URL=postgres://user:password@localhost:5432/launchwings_dev
# DATABASE_URL_POOLED=postgres://user:password@localhost:5432/launchwings_dev

# Resend — transactional email + waitlist welcome
# Get from https://resend.com/api-keys (free tier: 3000/mo, 100/day)
RESEND_API_KEY=re_xxx
# Verified sender (must be on a domain verified in Resend dashboard)
RESEND_FROM=social@launchwings.com
# Where new-signup notifications are mirrored (your real inbox; can be the same as RESEND_FROM if you set up Cloudflare Email Routing)
FOUNDER_EMAIL=social@launchwings.com

# Cloudflare Turnstile — anti-bot on the waitlist form (free, unlimited)
# Get from https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0xAAAA
TURNSTILE_SECRET_KEY=0xAAAA

# PostHog — events + product analytics (free: 1M events/mo)
# Get from https://posthog.com (project settings)
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional — Loops drip (only if you set up a Loops account)
# Get from https://app.loops.so/settings?page=api
# LOOPS_API_KEY=

# Clerk — auth for /app (ONB-06+). Get from https://dashboard.clerk.com
# (API Keys). The publishable key is safe to ship to the browser; the secret
# stays server-side only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# tRPC client — points at the deployed apps/api project. In local dev, leave
# unset to default to http://localhost:3001/trpc.
# NEXT_PUBLIC_API_URL=https://api.launchwings.com/trpc
