{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    "tooling/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NODE_ENV",
        "VERCEL_ENV",
        "NEXT_PUBLIC_*",
        "DATABASE_URL",
        "DATABASE_URL_POOLED",
        "INTERNAL_API_URL",
        "RESEND_API_KEY",
        "RESEND_FROM",
        "FOUNDER_EMAIL",
        "TURNSTILE_SECRET_KEY"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "check:assets": {
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}
