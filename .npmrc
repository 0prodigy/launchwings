node-linker=isolated
strict-peer-dependencies=true
auto-install-peers=true

# Hoist drizzle-orm to the workspace root node_modules. Without this, pnpm's
# isolated symlink layout works locally (every workspace pkg's node_modules
# symlinks to the same physical file in .pnpm/) but Vercel's Function bundler
# dereferences those symlinks into separate physical copies, producing
# `Types have separate declarations of a private property 'shouldInlineParams'`
# TS errors across @launchwings/db / @launchwings/trpc / @launchwings/agents.
# Hoisting drizzle-orm to the root forces a single physical copy that all
# packages resolve to, surviving Vercel's bundle copy step.
#
# Setting publicHoistPattern overrides pnpm's defaults — keep eslint/prettier
# patterns explicitly so we don't regress unrelated tooling.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*drizzle-orm*
